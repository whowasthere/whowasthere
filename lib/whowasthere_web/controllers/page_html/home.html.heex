<Layouts.shell flash={@flash}>
  <section
    id="start"
    class="start"
    data-new-url={~p"/new?format=json"}
    data-checkout-url={~p"/pay/checkout"}
    data-stripe={to_string(@stripe_enabled)}
  >
    <div class="start-hero">
      <h1 class="display-title start-title">Who Was There</h1>
      <p class="start-lead">
        Website analytics with no login and no visitor profiles. Two private links replace
        an account. One script, daily totals only — no cookies, no raw hit log.
      </p>
      <p class="start-hosted">
        <a href="#pricing">$30 / year</a>
        after 7 days free. <a href="#self-host">Self-host</a>
        if you want the keys.
      </p>
    </div>

    <script src="https://api.hads.dev/v1/hads.js?site=site_F7v4CJh18Dm4XZnSG64BlX4haf2xAanw" async>
    </script>

    <ol class="start-steps">
      <li class="panel start-step">
        <span class="start-n num">01</span>
        <div>
          <h2>Create a site</h2>
          <p>
            No signup. Instead of a password you get two secret links — save them like
            keys. Lose them and you lose access.
          </p>
          <button type="button" id="start-create" class="start-go">Create a site</button>
          <p id="start-meta" class="start-meta" hidden>
            site <span data-site class="num"></span> · <span data-plan></span>
          </p>
        </div>
      </li>

      <li class="panel start-step">
        <span class="start-n num">02</span>
        <div>
          <h2>Paste the tracker</h2>
          <p>One tag on your site. Use the same origin as this page.</p>
          <.copy_block
            id="start-snippet"
            code={~s(<script src="#{@base_url}/w.js" data-w="SITE_KEY" defer></script>)}
          />
        </div>
      </li>

      <li class="panel start-step">
        <span class="start-n num">03</span>
        <div>
          <h2>Save these two links</h2>
          <p>
            That is your “account”. Dashboard opens stats. Pay link is how you pay and
            renew later — by card or USDC.
          </p>
          <p class="start-sub">Dashboard</p>
          <.copy_block id="start-dash" code={"#{@base_url}/d/TOKEN"} />
          <a
            id="start-dash-open"
            class="start-open"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            hidden
          >
            Open dashboard
          </a>
          <p class="start-sub">Pay / renew</p>
          <.copy_block id="start-pay" code={"#{@base_url}/pay?pay=p_SECRET"} />
          <a
            id="start-pay-open"
            class="start-open"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            hidden
          >
            Open pay page
          </a>
        </div>
      </li>

      <li id="start-pay-step" class="panel start-step">
        <span class="start-n num">04</span>
        <div>
          <h2>Pay or renew</h2>
          <p>
            First year or next year — same steps. Card: choose the amount, click <strong>Pay with card</strong>. Crypto: send that much USDC on Solana, then <strong>I’ve paid — check</strong>. Open your saved pay link anytime to do
            this again.
          </p>
          <p id="start-payment-empty" class="payment-empty">
            Create a site first — card and deposit details show up here.
          </p>
          <div id="start-payment" class="payment-card" hidden>
            <div class="payment-qr-wrap">
              <canvas
                id="start-pay-qr"
                class="payment-qr"
                width="424"
                height="424"
                role="img"
                aria-label="Solana Pay QR code"
              ></canvas>
              <p>Scan with a Solana Pay wallet</p>
            </div>
            <div class="payment-details">
              <p class="start-sub payment-amount-label">Amount</p>
              <div id="start-pay-amount-control" class="payment-amount-control">
                <button
                  type="button"
                  id="start-pay-less"
                  class="payment-amount-button"
                  aria-label="Decrease payment by 30 USDC"
                  disabled
                >
                  <.icon name="hero-minus" class="size-4" />
                </button>
                <p id="start-pay-amount" class="payment-amount" aria-live="polite">30 USDC</p>
                <button
                  type="button"
                  id="start-pay-more"
                  class="payment-amount-button"
                  aria-label="Increase payment by 30 USDC"
                >
                  <.icon name="hero-plus" class="size-4" />
                </button>
              </div>
              <p id="start-pay-network" class="payment-network">Solana · mainnet-beta</p>
              <p class="start-sub">USDC deposit address</p>
              <.copy_block id="start-deposit" code="SOLANA_ADDRESS" />
              <div class="payment-actions">
                <div class="payment-pay-ways">
                  <button
                    type="button"
                    id="start-pay-card"
                    class="payment-btn payment-btn--primary"
                    hidden
                  >
                    Pay with card
                  </button>
                  <a
                    id="start-wallet-open"
                    class="payment-btn payment-btn--secondary"
                    href="#"
                    hidden
                  >
                    Open Solana wallet
                  </a>
                </div>
                <button type="button" id="start-pay-check" class="payment-btn payment-btn--ghost">
                  I’ve paid — check
                </button>
              </div>
              <p id="start-pay-status" class="payment-status" aria-live="polite"></p>
            </div>
          </div>
        </div>
      </li>
    </ol>
  </section>
  <aside
    id="hads-create"
    class="panel hads-unit"
    data-hads-slot="create"
    data-hads-topic="web analytics privacy"
    data-hads-allow-self
  >
    <a data-hads-attribution class="hads-unit-attribution">Ads by HADS</a>
    <strong data-hads-title>
      <span class="hads-unit-skeleton hads-unit-skeleton--title" aria-hidden="true"></span>
    </strong>
    <p data-hads-text>
      <span class="hads-unit-skeleton hads-unit-skeleton--text" aria-hidden="true"></span>
      <span
        class="hads-unit-skeleton hads-unit-skeleton--text hads-unit-skeleton--text-short"
        aria-hidden="true"
      ></span>
    </p>
    <a data-hads-url></a>
  </aside>

  <section id="pricing" class="mt-14 scroll-mt-24 sm:mt-20">
    <p class="eyebrow">pricing</p>
    <div class="panel mt-4 overflow-hidden">
      <div class="border-b border-base-content/8 px-6 py-7 sm:px-8">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm text-base-content/55">
              One pay link · unlimited sites
            </p>
            <p class="mt-2 text-4xl font-semibold tracking-tighter sm:text-5xl">
              30 <span class="text-xl text-primary sm:text-2xl">USD / year</span>
            </p>
          </div>
          <p class="max-w-sm text-sm leading-relaxed text-base-content/55">
            No accounts — your saved pay link is how you pay and renew. Card or USDC on Solana.
            Next year: open that link and pay again the same way. Extra $30 adds another
            500,000 pageviews / month.
          </p>
        </div>
      </div>
      <div class="grid divide-y divide-base-content/8 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        <div class="px-6 py-5 sm:px-8">
          <p class="eyebrow">trial</p>
          <p class="mt-2 text-sm">7 days</p>
        </div>
        <div class="px-6 py-5 sm:px-8">
          <p class="eyebrow">included</p>
          <p class="mt-2 text-sm">500,000 pageviews / month</p>
        </div>
        <div class="px-6 py-5 sm:px-8">
          <p class="eyebrow">top-up</p>
          <p class="mt-2 text-sm">+500,000 per extra 30 USDC</p>
        </div>
      </div>
    </div>
  </section>

  <article id="readme" class="readme readme-follow">
    <p class="eyebrow">docs</p>
    {raw(@readme)}
  </article>
</Layouts.shell>
