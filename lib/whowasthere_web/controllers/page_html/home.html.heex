<Layouts.shell flash={@flash}>
  <section
    id="start"
    class="start"
    data-new-url={~p"/new?format=json"}
  >
    <p class="eyebrow">start</p>
    <h1 class="display-title">Who Was There</h1>
    <p class="start-lead">
      Privacy-first web analytics with no cookies or raw visit logs — only useful aggregates. The commands,
      tracker, dashboard, and payment instructions below use this instance’s origin. Create a site, paste the
      tag, and save its private dashboard link. Seven days free, then <a href="#pricing">$30 USDC / year</a>.
      For your own deployment, see <a href="#self-host">self-host</a>.
    </p>

    <script src="https://api.hads.dev/v1/hads.js?site=site_F7v4CJh18Dm4XZnSG64BlX4haf2xAanw" async>
    </script>

    <ol class="start-steps">
      <li class="panel start-step">
        <span class="start-n num">01</span>
        <div>
          <h2>Create a site</h2>
          <p>
            Same as <code>curl /new</code>. This response contains the only dashboard URL; it is
            never added to the tracker snippet.
          </p>
          <.copy_block id="start-curl" code={"curl -s #{@base_url}/new"} />
          <button type="button" id="start-create" class="start-go">Create a site</button>
          <p id="start-meta" class="start-meta" hidden>
            site <span data-site class="num"></span> · <span data-plan></span>
          </p>
        </div>
      </li>

      <li class="panel start-step">
        <span class="start-n num">02</span>
        <div>
          <h2>Paste the tracker</h2>
          <p>In <code>&lt;head&gt;</code> or before <code>&lt;/body&gt;</code>. No cookies.</p>
          <.copy_block
            id="start-snippet"
            code={~s(<script src="#{@base_url}/w.js" data-w="SITE_KEY" defer></script>)}
          />
          <p class="start-sub">No JavaScript? A pixel counts pageviews only.</p>
          <.copy_block
            id="start-pixel"
            code={~s(<img src="#{@base_url}/w.js?s=SITE_KEY" alt="" width="1" height="1">)}
          />
        </div>
      </li>

      <li class="panel start-step">
        <span class="start-n num">03</span>
        <div>
          <h2>Keep the dashboard</h2>
          <p>Private signed URL. Save it when the site is created.</p>
          <.copy_block id="start-dash" code={"#{@base_url}/d/TOKEN"} />
          <a
            id="start-dash-open"
            class="start-open"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            hidden
          >
            Open dashboard
          </a>
          <p class="start-sub">Custom events, after the script:</p>
          <.copy_block id="start-event" code="window.wwt('signup')" />
        </div>
      </li>

      <li id="start-pay-step" class="panel start-step">
        <span class="start-n num">04</span>
        <div>
          <h2>Pay when you’re ready</h2>
          <p>
            Seven days are free. After that, send 30 USDC on Solana. The address stays with this
            payment profile and is also used for every renewal.
          </p>
          <p id="start-payment-empty" class="payment-empty">
            Create a site first — its private payment profile will appear here.
          </p>
          <div id="start-payment" class="payment-card" hidden>
            <div class="payment-qr-wrap">
              <canvas
                id="start-pay-qr"
                class="payment-qr"
                width="424"
                height="424"
                role="img"
                aria-label="Solana Pay QR code"
              ></canvas>
              <p>Scan with a Solana Pay wallet</p>
            </div>
            <div class="payment-details">
              <p id="start-pay-amount" class="payment-amount">30 USDC</p>
              <p id="start-pay-network" class="payment-network">Solana · mainnet-beta</p>
              <p class="start-sub">Permanent deposit address</p>
              <.copy_block id="start-deposit" code="SOLANA_ADDRESS" />
              <div class="payment-actions">
                <a id="start-wallet-open" class="start-open" href="#" hidden>Open wallet</a>
                <button type="button" id="start-pay-check" class="start-go">
                  I’ve paid — check
                </button>
              </div>
              <p id="start-pay-status" class="payment-status" aria-live="polite"></p>
            </div>
            <div class="payment-secret">
              <p class="start-sub">Save this private payment URL with the dashboard</p>
              <.copy_block id="start-pay" code={"#{@base_url}/pay?pay=p_SECRET"} />
              <a
                id="start-pay-open"
                class="start-open"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
              >
                Open payment profile
              </a>
            </div>
          </div>
        </div>
      </li>
    </ol>
  </section>
  <aside
    id="hads-create"
    class="panel hads-unit"
    data-hads-slot="create"
    data-hads-topic="web analytics privacy"
    data-hads-allow-self
  >
    <a data-hads-attribution class="hads-unit-attribution">Ads by HADS</a>
    <strong data-hads-title>
      <span class="hads-unit-skeleton hads-unit-skeleton--title" aria-hidden="true"></span>
    </strong>
    <p data-hads-text>
      <span class="hads-unit-skeleton hads-unit-skeleton--text" aria-hidden="true"></span>
      <span
        class="hads-unit-skeleton hads-unit-skeleton--text hads-unit-skeleton--text-short"
        aria-hidden="true"
      ></span>
    </p>
    <a data-hads-url></a>
  </aside>

  <section id="pricing" class="mt-14 scroll-mt-24 sm:mt-20">
    <p class="eyebrow">pricing</p>
    <div class="panel mt-4 overflow-hidden">
      <div class="border-b border-base-content/8 px-6 py-7 sm:px-8">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm text-base-content/55">
              One plan for every site in a payment profile
            </p>
            <p class="mt-2 font-mono text-4xl font-medium tracking-tighter sm:text-5xl">
              30 <span class="text-xl text-primary sm:text-2xl">USDC / year</span>
            </p>
          </div>
          <p class="max-w-xs text-sm leading-relaxed text-base-content/55">
            Seven days free. Payments run on Solana and settle only when you use your private payment URL.
          </p>
        </div>
      </div>
      <div class="grid divide-y divide-base-content/8 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        <div class="px-6 py-5 sm:px-8">
          <p class="eyebrow">sites</p>
          <p class="mt-2 text-sm">Unlimited</p>
        </div>
        <div class="px-6 py-5 sm:px-8">
          <p class="eyebrow">included</p>
          <p class="mt-2 text-sm">500,000 pageviews / month</p>
        </div>
        <div class="px-6 py-5 sm:px-8">
          <p class="eyebrow">scale</p>
          <p class="mt-2 text-sm">+500,000 for each extra 30 USDC</p>
        </div>
      </div>
    </div>
  </section>

  <article id="readme" class="readme readme-follow">
    {raw(@readme)}
  </article>
</Layouts.shell>
